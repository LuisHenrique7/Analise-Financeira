table Medidas
	lineageTag: b166df5a-2038-41d2-a4b0-9667f1b2b4b4

	measure 'Quantidade de Meses Pagos' =
			DISTINCTCOUNT ('Dividendos pagos por data (2021-2025)'[AnoMes])
			/*VAR AnoSelecionado = SELECTEDVALUE('Dividendos pagos por data (2023-2025)'[Ano])
			RETURN
			    SWITCH(
			        AnoSelecionado,
			        2023, SUM(Ativos[Quantidade em 2023]),
			        2024, SUM(Ativos[Quantidade em 2024]),
			        2025, SUM(Ativos[Quantidade em 2025]),
			        SUM(Ativos[Quantidade em 2023]) + SUM(Ativos[Quantidade em 2024]) + SUM(Ativos[Quantidade em 2025])
			    )
			*/
		formatString: 0
		lineageTag: 4ae43d9f-2483-4dd8-aa91-515662d75b51

	measure 'Média de pagamento' = SUM('Dividendos pagos por data (2021-2025)'[VALOR]) / Medidas[Quantidade de Meses Pagos]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 565c0bb1-7566-44ae-9262-7613ab174195

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'VALOR MULTIPLICADO' = ```
			
			/*
			VALOR MULTIPLICADO = IF(SELECTEDVALUE('Dividendos pagos por data (2023-2025)'[ATIVO]) = "PETR4" || SELECTEDVALUE('Dividendos pagos por data (2023-2025)'[ATIVO]) = "CURY3" 
			|| SELECTEDVALUE('Dividendos pagos por data (2023-2025)'[ATIVO]) = "TIMS3" || SELECTEDVALUE('Dividendos pagos por data (2023-2025)'[ATIVO]) = "TAEE11" 
			|| SELECTEDVALUE('Dividendos pagos por data (2023-2025)'[ATIVO]) = "VBBR3" 
			, SUM('Dividendos pagos por data (2023-2025)'[VALOR]) * 2, SUM('Dividendos pagos por data (2023-2025)'[VALOR]))
			*/
			VAR AtivoSelecionado = SELECTEDVALUE('Dividendos pagos por data (2021-2025)'[ATIVO])
			VAR ValorBase = SUM('Dividendos pagos por data (2021-2025)'[VALOR])
			RETURN
			    SWITCH(
			        TRUE(),
			        AtivoSelecionado IN {"PETR4"}, ValorBase * 2,
			        AtivoSelecionado IN {"TAEE11", "CURY3"}, ValorBase * 3,
			        AtivoSelecionado = "VBBR3", ValorBase * 2,
			        AtivoSelecionado = "TIMS3", ValorBase * 4,
			        ValorBase
			    ) / DISTINCTCOUNT('Dividendos pagos por data (2021-2025)'[DATA PAGAMENTO].[Ano])
			```
		lineageTag: 714de1d9-6e52-4ec9-a392-7fa7d14c0083

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Média de Dividendos' = SUM('Dividendos pagos por data (2021-2025)'[VALOR]) / DISTINCTCOUNT('Dividendos pagos por data (2021-2025)'[DATA PAGAMENTO].[Ano])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 67929952-6f16-4b0c-be7f-990d48ce2902

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Média de DY' = SUM('Dividendos pagos por data (2021-2025)'[DY]) / DISTINCTCOUNT('Dividendos pagos por data (2021-2025)'[DATA PAGAMENTO].[Ano])
		lineageTag: bb12ecc0-9049-47e7-9c2d-2e8e8b5bebda

