	measure 'DY Médio' = [Média de DY] / DISTINCTCOUNT(Ativos[Ativo])
		lineageTag: c75e1f89-b416-4ac7-82a2-4e18dfea0dae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Renda Média' = Medidas[Média de Dividendos] / 12
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 42662739-1331-49a7-9e9a-194c77081476

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Média de Preço de Fechamento' = ```
			
			VAR MediaPreco = IF(DISTINCTCOUNT(historico_ativos[Ativo]) = 1, 
			    CALCULATE(
			        SUM(historico_ativos[close]) / COUNT(historico_ativos[Ativo]), 
			        ALLSELECTED(historico_ativos)
			    ),
			    CALCULATE(
			        SUM(historico_ativos[close]),
			        ALLSELECTED(historico_ativos[Data])
			    ) / 
			    CALCULATE(
			        DISTINCTCOUNT(historico_ativos[Data]),
			        ALLSELECTED(historico_ativos[Data])
			    )
			)
			
			RETURN IF(SUM(historico_ativos[close]) > 0, MediaPreco, BLANK())
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: bdf5c0ed-ae06-47f1-a7ed-01d94929da6e

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Valor Abaixo da Média de Preço' = ```
			
			VAR AtivoSelecionado = SELECTEDVALUE(historico_ativos[Ativo])
			
			VAR MediaPrecoPorAtivo = 
			IF(DISTINCTCOUNT(historico_ativos[Ativo]) = 1, 
			    CALCULATE(
			        SUM(historico_ativos[close]) / COUNT(historico_ativos[Ativo]), 
			        ALLSELECTED(historico_ativos),
			        KEEPFILTERS(historico_ativos[Ativo] = AtivoSelecionado)
			    ),
			    CALCULATE(
			        SUM(historico_ativos[close]),
			        ALLSELECTED(historico_ativos[Data]),
			        KEEPFILTERS(historico_ativos[Ativo] = AtivoSelecionado)
			    ) / 
			    CALCULATE(
			        DISTINCTCOUNT(historico_ativos[Data]),
			        ALLSELECTED(historico_ativos[Data]),
			        KEEPFILTERS(historico_ativos[Ativo] = AtivoSelecionado)
			    )
			)
			
			VAR DataRecentePorAtivo =
			CALCULATE (
			    MAX ( historico_ativos[Data] ),
			    FILTER (
			        historico_ativos,
			        historico_ativos[Ativo] = SELECTEDVALUE ( historico_ativos[Ativo] )
			    )
			)
			
			
			RETURN 
			    CALCULATE(
			        MediaPrecoPorAtivo - SUM(historico_ativos[close]),
			        FILTER(
			            historico_ativos,
			            historico_ativos[Data] = DataRecentePorAtivo
			        )
			    )
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: a3ce5d8c-8872-4d8e-87e0-5adc50fb4021

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Preço Atual' =
			
			
			VAR DataRecente = MAX (historico_ativos[Data])
			
			RETURN CALCULATE(
			    SUM(historico_ativos[close]),
			    FILTER (
			        historico_ativos,
			        historico_ativos[Data] = DataRecente
			    )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: e3fc0a3b-c0b5-4a9d-aa6c-d164fc1d3151

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Recomendação = IF(HASONEVALUE(Ativos[ATIVO]), SELECTEDVALUE(Ativos[RECOMENDACAO]) , BLANK())
		lineageTag: 6df3a72b-32ae-44a9-ac62-6650b5cffdab

	measure 'Média de Dividendos Totais' =
			
			/*SUM('Dividendos pagos por data (2021-2025)'[Valor Multiplicado por número de cotas]) / DISTINCTCOUNT('Dividendos pagos por data (2021-2025)'[DATA PAGAMENTO].[Ano])*/
			VAR QtdAnos = DISTINCTCOUNT ('Dividendos pagos por data (2021-2025)'[DATA PAGAMENTO].[Ano])
			
			RETURN SUMX(
			    'Dividendos pagos por data (2021-2025)',
			    'Dividendos pagos por data (2021-2025)'[VALOR] * RELATED('Multiplicadores de Cota'[Multiplicador])
			) / QtdAnos
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: c8841a57-4250-4a45-b1fc-34e63ad98d1d

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Renda Média Total' = Medidas[Média de Dividendos Totais] / 12
		lineageTag: 915964ce-1f3c-4e0f-8142-d8b5a6adf8e6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Preço Atual Total' =
			
			
			VAR DataRecente = MAX (historico_ativos[Data])
			
			RETURN SUMX (
			    FILTER (historico_ativos, historico_ativos[Data] = DataRecente),
			    historico_ativos[close] * RELATED('Multiplicadores de Cota'[Multiplicador])
			)
		lineageTag: f3b7d43a-70e1-49a6-b82b-35439da18504

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Média de DY Total' = (Medidas[Média de Dividendos Totais] / Medidas[Preço Atual Total]) * 100
		lineageTag: 5a1ed304-337f-4003-9828-498334501447

		annotation PBI_FormatHint = {"isGeneralNumber":true}

