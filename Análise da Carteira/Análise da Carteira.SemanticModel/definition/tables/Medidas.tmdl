	measure 'AAA carti mult' =
			
			SUMX(
			    VALUES(historico_ativos_carteira[Data]),
			    VAR dataHistorico = historico_ativos_carteira[Data]
			
			    VAR precoTotal = SUMX(
			        VALUES('Exemplo Aquisição'[Ativo]),
			        VAR ativo = 'Exemplo Aquisição'[Ativo]
			
			        VAR cotasAteData = CALCULATE(
			            SUM('Exemplo Aquisição'[Número de Cotas]),
			            'Exemplo Aquisição'[Ativo] = ativo,
			            'Exemplo Aquisição'[Data] <= dataHistorico
			        )
			
			        VAR preco = CALCULATE(
			            cotasAteData * SUM(historico_ativos_carteira[close]),
			            historico_ativos_carteira[Ativo] = ativo,
			            historico_ativos_carteira[Data] = dataHistorico,
			            TREATAS(VALUES('Exemplo Aquisição'[Chave de Histórico]), historico_ativos_carteira[Chave de Histórico])
			        )
			
			        RETURN preco
			    )
			    RETURN precoTotal
			)
		lineageTag: fd3ffe4b-0dea-491a-8d7c-b469fc8b3a7f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valor Investido' =
			CALCULATE(
			    SUM('Exemplo Aquisição'[Valor investido]),
			    'Exemplo Aquisição'[Data] = MAX(historico_ativos_carteira[Data])
			)
		lineageTag: ed501c66-d40e-4cf7-9014-c66fe229e842

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Value
		formatString: 0
		lineageTag: 02466e31-5880-40ad-967e-ab0f6d8e1b18
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition Medidas = calculated
		mode: import
