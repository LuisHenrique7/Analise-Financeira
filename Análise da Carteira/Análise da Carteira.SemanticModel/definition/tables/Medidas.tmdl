	measure 'Dividendos Recebidos' = ```
			
			SUMX (
			    'Dividendos pagos por data (2021-2025)',
			    VAR AtivoAtual = 'Dividendos pagos por data (2021-2025)'[Ativo]
			    VAR DataCom = 'Dividendos pagos por data (2021-2025)'[DATA COM]
			    VAR CotasCompradas =
			        CALCULATE (
			            SUM ( 'Exemplo Aquisição'[Número de Cotas] ),
			            FILTER (
			                'Exemplo Aquisição',
			                'Exemplo Aquisição'[Ativo] = AtivoAtual &&
			                'Exemplo Aquisição'[Data] <= DataCom
			            )
			        )
			    RETURN
			        'Dividendos pagos por data (2021-2025)'[Valor] * CotasCompradas
			)
			
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: ace733c3-d091-46d3-b6ab-3bcc31c3516e

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total acumulado de Dividendos Recebidos em DATA PAGAMENTO' =
			
			CALCULATE(
				[Dividendos Recebidos],
				FILTER(
					ALLSELECTED('Dividendos pagos por data (2021-2025)'[DATA PAGAMENTO]),
					ISONORAFTER('Dividendos pagos por data (2021-2025)'[DATA PAGAMENTO], MAX('Dividendos pagos por data (2021-2025)'[DATA PAGAMENTO]), DESC)
				)
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
