	measure 'Valor Carteira Acumulado' =
			
			SUMX (
			    historico_ativos_carteira,
			    VAR DataAtual = historico_ativos_carteira[Data]
			    VAR AtivoAtual = historico_ativos_carteira[Ativo]
			    VAR Preco = historico_ativos_carteira[close]
			    VAR chave = historico_ativos_carteira[Chave de Histórico]
			
			    VAR CotasAcumuladas =
			        CALCULATE (
			            SUM ( 'Exemplo Aquisição'[Número de Cotas] ),
			            --TREATAS ( { chave }, 'Exemplo Aquisição'[Chave de Histórico] ),
			            KEEPFILTERS ( FILTER ( 'Exemplo Aquisição', 'Exemplo Aquisição'[Ativo] = AtivoAtual ) ),
			            FILTER (
			                ALL ( 'Exemplo Aquisição'[Data] ),
			                'Exemplo Aquisição'[Ativo] = AtivoAtual
			                    && 'Exemplo Aquisição'[Data] <= DataAtual
			            )
			        )
			    RETURN
			        Preco * CotasAcumuladas
			)
		lineageTag: 861b188d-cdd3-4732-bdb6-82741603fa36

	measure teste =
			
			VAR HistTable =
			    SUMMARIZE(
			        historico_ativos_carteira,
			        historico_ativos_carteira[Ativo],
			        historico_ativos_carteira[Data],
			        "Close", MAX( historico_ativos_carteira[close] )
			    )
			RETURN
			SUMX(
			    HistTable,
			    VAR CurAtivo  = [Ativo]
			    VAR CurData   = [Data]
			    VAR CurClose  = [Close]
			    VAR CotasAcum =
			        CALCULATE(
			            SUM( 'Exemplo Aquisição'[Número de Cotas] ),
			            -- remove apenas o filtro de Data (preserva Dono/Outros filtros)
			            ALL( 'Exemplo Aquisição'[Data] ),
			            -- aplica filtro pelo ativo da linha atual (CurAtivo)
			            'Exemplo Aquisição'[Ativo] = CurAtivo,
			            -- aplica condição de acumulação até a data corrente
			            'Exemplo Aquisição'[Data] <= CurData,
			            REMOVEFILTERS(historico_ativos_carteira[Data])
			        )
			    RETURN CurClose * CotasAcum
			)
		lineageTag: 10309af1-bd30-48bd-a3ca-3cdd744e447c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Investido Acumulado' =
			CALCULATE(
