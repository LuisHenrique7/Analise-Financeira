	measure 'teste 2' = ```
			
			VAR HistTable =
			    SUMMARIZE(
			        historico_ativos_carteira,
			        historico_ativos_carteira[Ativo],
			        historico_ativos_carteira[Data],
			        "Close", MAX( historico_ativos_carteira[close] )
			    )
			RETURN
			SUMX(
			    HistTable,
			    VAR CurAtivo  = [Ativo]
			    VAR CurData   = [Data]
			    VAR CurClose  = [Close]
			
			        /* última data de aquisição desse ativo (independente dos filtros de data) */
			    VAR LastAcqDate =
			        CALCULATE(
			            MAX( 'Exemplo Aquisição'[Data] ),
			            'Exemplo Aquisição'[Ativo] = CurAtivo
			        )
			
			    /* Se já passou da última compra, usamos a última data de compra como "effective date" */
			    VAR EffectiveDate =
			        IF( NOT( ISBLANK( LastAcqDate ) ) && CurData > LastAcqDate, LastAcqDate, CurData )
			    
			    VAR CotasAcum =
			        CALCULATE(
			            SUM( 'Exemplo Aquisição'[Número de Cotas] ),
			            -- remove apenas o filtro de Data (preserva Dono/Outros filtros)
			            ALL( 'Exemplo Aquisição'[Data] ),
			            -- aplica filtro pelo ativo da linha atual (CurAtivo)
			            'Exemplo Aquisição'[Ativo] = CurAtivo,
			            -- aplica condição de acumulação até a data corrente
			            'Exemplo Aquisição'[Data] <= EffectiveDate
			        )
			    RETURN LastAcqDate
			)
			```
		formatString: General Date
		lineageTag: a53f5b47-db9f-42a3-82c0-59a74476bfc6

