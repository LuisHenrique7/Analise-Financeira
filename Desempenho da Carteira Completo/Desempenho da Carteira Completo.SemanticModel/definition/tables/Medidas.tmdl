	measure 'Quantidade de Itens' =
			
			SUMX(
			    carteira_ativos,
			    VAR ativo = carteira_ativos[Ativo]
			    VAR balanco = carteira_ativos[Balanço de Cotas]
			    VAR n_cotas_atual = CALCULATE(
			        SUM('Aquisições Realizadas'[Número de Cotas]),
			        'Aquisições Realizadas'[Ativo] = ativo
			    )
			
			    RETURN CALCULATE(
			        n_cotas_atual / balanco,
			        'Aquisições Realizadas'[Ativo] = ativo
			    )
			)
		lineageTag: bcc6d6a2-7e3f-4f1d-90ab-2026960e7732

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quantidade de Carteiras' = ```
			
			VAR CarteiraAtual = SELECTEDVALUE(carteira_ativos[Carteira])
			
			RETURN MINX(
			    FILTER(
			        ALL(carteira_ativos),
			        carteira_ativos[Carteira] = CarteiraAtual
			    ),
			    VAR ativo = carteira_ativos[Ativo]
			    VAR balanco = carteira_ativos[Balanço de Cotas]
			    VAR n_cotas_atual = CALCULATE(
			        SUM('Aquisições Realizadas'[Número de Cotas]),
			        'Aquisições Realizadas'[Ativo] = ativo
			    )
			
			    RETURN DIVIDE(n_cotas_atual, balanco)
			    
			)
			```
		lineageTag: 71da0296-c4ce-4b23-a424-1c039c752c81

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Diferença Itens vs Carteiras' =
			
			VAR ItensPorAtivo = [Quantidade de Itens]
			
			VAR MenorCarteira =
			    CALCULATE(
			        [Quantidade de Carteiras],
			        ALL(carteira_ativos[Ativo]),
			        carteira_ativos[Carteira] = SELECTEDVALUE(carteira_ativos[Carteira]),
			        'Aquisições Realizadas'[Dono] = SELECTEDVALUE('Aquisições Realizadas'[Dono])
			    )
			
			RETURN ItensPorAtivo - MenorCarteira
			
