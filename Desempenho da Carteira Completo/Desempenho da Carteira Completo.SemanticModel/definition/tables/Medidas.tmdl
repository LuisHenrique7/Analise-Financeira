		lineageTag: 599ba7c9-fb1d-422d-ae82-550ab710c0aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Percentual na carteira' =
			
			VAR investido_ativo = SUM('Aquisições Realizadas'[Valor Investido])
			
			VAR investido_geral = CALCULATE(
			    SUM('Aquisições Realizadas'[Valor Investido]),
			    REMOVEFILTERS('Aquisições Realizadas'),
			    'Aquisições Realizadas'[Dono] = SELECTEDVALUE('Aquisições Realizadas'[Dono])
			)
			
			VAR data = CALCULATE(
			    MAX('Aquisições Realizadas'[Data]),
			    'Aquisições Realizadas'[Ativo] = SELECTEDVALUE('Aquisições Realizadas'[Ativo])
			)
			
			VAR lucro_ativo = CALCULATE(
			    SUM('Aquisições Realizadas'[Lucro]),
			    'Aquisições Realizadas'[Data] = data
			)
			
			VAR lucro_geral = CALCULATE(
			    SUM('Aquisições Realizadas'[Lucro]),
			    REMOVEFILTERS('Aquisições Realizadas'),
			    'Aquisições Realizadas'[Dono] = SELECTEDVALUE('Aquisições Realizadas'[Dono]),
			    'Aquisições Realizadas'[Data] = data
			)
			
			RETURN (lucro_ativo + investido_ativo) / (investido_geral + lucro_geral)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b97ef09b-2b37-4dcb-84c3-fcdbc8697d55

	measure 'Percentual visado' =
			
			
			// VAR data = CALCULATE(
