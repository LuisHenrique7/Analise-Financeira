			RETURN preco_medio / total
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8527cc87-858a-4d89-ba8f-25a081501b13

	measure 'valor padrão' =
			SUMX(
			    carteira_ativos,
			    VAR ativo = carteira_ativos[Ativo]
			    VAR balanco = carteira_ativos[Balanço de Cotas]
			
			    VAR data = CALCULATE(
			        MAX('Aquisições Realizadas'[Data]),
			        'Aquisições Realizadas'[Ativo] = ativo
			    )
			
			    VAR preco_medio = CALCULATE(
			        SUM('Aquisições Realizadas'[Preço Médio]) * SUM(carteira_ativos[Balanço de Cotas]),
			        'Aquisições Realizadas'[Data] = data
			    )
			
			    RETURN preco_medio
			)
		lineageTag: 26340276-1e7d-44d3-bb13-fdc9a292bb33

